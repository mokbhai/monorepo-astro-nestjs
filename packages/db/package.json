{
  "name": "@workspace-starter/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm run build",
    "lint": "eslint \"src/**/*.ts\" \"prisma.config.ts\" --ignore-pattern \"src/generated/**\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.15.5",
    "@workspace-starter/config-typescript": "workspace:*",
    "dotenv": "^17.2.3",
    "eslint": "catalog:dev-tools",
    "prisma": "catalog:",
    "typescript": "catalog:"
  }
}
